{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [
      {
        "include": "modules/relatorios/modelo/*.docx",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
