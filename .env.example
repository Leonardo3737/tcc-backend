# --- Aplicacao ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Origens liberadas no CORS, separadas por virgula (frontend Next.js)
CORS_ORIGINS=http://localhost:3001

# Base dos links enviados nos e-mails de notificacao. Normalmente coincide com
# o CORS_ORIGINS, mas e um valor unico, nao uma lista. Barra final e ignorada.
URL_FRONT=http://localhost:3001

# --- Banco de dados (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoria
DB_USER=monitoria
DB_PASSWORD=monitoria
DB_LOGGING=true

# --- Autenticacao ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# D-09 (em aberto): restringe a criacao de contas a dominios institucionais.
# Vazio = qualquer dominio aceito. Ex.: ufx.edu.br,aluno.ufx.edu.br
EMAIL_DOMINIOS_PERMITIDOS=

# --- E-mail transacional (Brevo) ---
# OBRIGATORIO EM PRODUCAO: a senha de usuarios novos e o codigo de recuperacao
# so chegam por e-mail. Com NODE_ENV=production e estes campos vazios, a
# aplicacao se recusa a subir. Vazio em desenvolvimento = modo log.
#
# Plano gratuito do Brevo: 300 e-mails/dia. A chave sai de
# app.brevo.com > SMTP & API > API Keys.
# ATENCAO: o remetente precisa ser um endereco verificado no painel do Brevo.
BREVO_API_KEY=
EMAIL_REMETENTE_NOME=Plataforma de Monitoria
EMAIL_REMETENTE_EMAIL=

# --- Avisos por e-mail ---
# Desligado por padrao de proposito. Antes de ligar, confira que a base nao tem
# contas de teste com enderecos inexistentes: a rotina de lembrete envia para
# TODOS os envolvidos nos atendimentos do dia, e bounce em volume prejudica a
# reputacao do remetente no Brevo.
NOTIFICACOES_HABILITADAS=false

# --- Trilha de requisicoes ---
# Uma linha em logs_requisicao por requisicao atendida. Ligada por padrao.
# Senha, codigo de recuperacao e token sao redigidos antes de gravar
# (src/modules/logs/redacao.ts). A tabela cresce sem limite: defina uma politica
# de retencao antes de uso prolongado.
LOGS_REQUISICAO_HABILITADOS=true

# Fuso usado para validar atendimento contra a disponibilidade semanal do monitor.
TIMEZONE_INSTITUICAO=America/Porto_Velho

# --- D-15: limites de agendamento (opcionais) ---
# Os dois de antecedencia vem 0 por padrao: qualquer horario futuro e aceito e o
# aluno pode desistir ate o inicio. Aperte conforme a politica da instituicao.
AGENDAMENTO_DURACAO_MINIMA_MINUTOS=15
AGENDAMENTO_DURACAO_MAXIMA_MINUTOS=240
# Duracao sugerida ao cliente. Precisa ficar ENTRE a minima e a maxima: fora da
# faixa, a aplicacao nao sobe.
AGENDAMENTO_DURACAO_PADRAO_MINUTOS=60
AGENDAMENTO_ANTECEDENCIA_MINIMA_MINUTOS=0
CANCELAMENTO_ANTECEDENCIA_MINIMA_MINUTOS=0

# =====================================================================
#  Variaveis usadas apenas pelos SCRIPTS — a aplicacao nao le nenhuma
#  delas, e por isso nao aparecem em env.validation.ts.
#
#  Todas tem default e podem ficar comentadas. Estao aqui para serem
#  descobertas: ate agora so existiam dentro do codigo dos scripts.
# =====================================================================

# --- npm run test:fluxo (scripts/fluxo-completo.mjs) ---
# Onde a API esta respondendo.
# API_BASE=http://localhost:3000/api

# Professor usado para iniciar o fluxo. Sem auto-cadastro, o script precisa de
# um professor que ele nao pode criar; o default e o do seeder de
# desenvolvimento (npm run db:seed). Aponte para outro se a sua base nao tiver
# os dados de desenvolvimento.
# FLUXO_EMAIL_PROFESSOR=joao.ribeiro@ufx.edu.br
# FLUXO_SENHA_PROFESSOR=senhaSegura123

# --- npm run criar-professor (scripts/criar-professor.mjs) ---
# Alternativa aos argumentos --nome, --email e --senha. Uteis em provisionamento
# automatizado, onde passar valores pela linha de comando os deixa no historico
# do shell e na lista de processos.
#
# PROFESSOR_SENHA fica DELIBERADAMENTE sem valor de exemplo: omitindo as duas
# formas, o script gera uma senha aleatoria e a imprime uma unica vez, que e o
# caminho preferivel.
# PROFESSOR_NOME=
# PROFESSOR_EMAIL=
# PROFESSOR_SENHA=
